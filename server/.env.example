# Required — your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Models (defaults shown). The planner does the reasoning; the summarizer only phrases results.
PLANNER_MODEL=gpt-4.1-mini
SUMMARY_MODEL=gpt-4.1-mini
BASELINE_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Only used by reasoning models (gpt-5*, o*): minimal | low | medium | high
REASONING_EFFORT=minimal

# Tool retrieval: hybrid (BM25 + embeddings) or bm25 (no embedding calls)
RETRIEVAL=hybrid
# Give up on the query embedding after this many ms and use keyword search only
EMBED_TIMEOUT_MS=800
TOP_K=10

# Final answer: auto (template for simple runs, cheap model otherwise) | llm | template
SUMMARY_MODE=auto

# Ask for confirmation when a write touches more than this many records
BULK_CONFIRM_THRESHOLD=10
MAX_PLANNER_CALLS=3
BASELINE_MAX_ITERATIONS=14
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# The app uses the real current date, and the sample data is generated around it.
# Set FIXED_NOW to pin the app to a date instead. Tests and the benchmark always use
# their own reference date (2026-10-15T10:00:00Z), so their results are reproducible.
# FIXED_NOW=2026-10-15T10:00:00.000Z
SEED=42
PORT=8787

# Optional: override token prices (USD per 1M tokens)
# PRICING_JSON={"gpt-4.1-mini":{"input":0.4,"cachedInput":0.1,"output":1.6}}
# Optional: OpenAI-compatible endpoint
# OPENAI_BASE_URL=
